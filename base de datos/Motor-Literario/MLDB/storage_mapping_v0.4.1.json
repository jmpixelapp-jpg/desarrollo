{
  "format": "MLDB_STORAGE_MAPPING",
  "mapping_version": 4,
  "schema_version": "0.4.1",
  "storage_model": "journal-first-key-value",
  "runtime": {
    "technology": "IndexedDB nativo",
    "database_name": "motor-literario-local",
    "database_version": 16,
    "object_stores": [
      {
        "name": "project-settings",
        "keyPath": [
          "projectId",
          "key"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ]
        ]
      },
      {
        "name": "documents",
        "keyPath": [
          "projectId",
          "documentId"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ]
        ]
      },
      {
        "name": "changes",
        "keyPath": [
          "projectId",
          "documentId",
          "sequence"
        ],
        "indexes": [
          [
            "by-document-sequence",
            [
              "projectId",
              "documentId",
              "sequence"
            ],
            true
          ]
        ]
      },
      {
        "name": "narrative-entities",
        "keyPath": [
          "projectId",
          "id"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ]
        ]
      },
      {
        "name": "narrative-relations",
        "keyPath": [
          "projectId",
          "id"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ]
        ]
      },
      {
        "name": "narrative-events",
        "keyPath": [
          "projectId",
          "id"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ]
        ]
      },
      {
        "name": "narrative-ideas",
        "keyPath": [
          "projectId",
          "id"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ]
        ]
      },
      {
        "name": "personal-idea-library",
        "keyPath": [
          "writerId",
          "sourceProjectId",
          "idea.id"
        ],
        "indexes": [
          [
            "by-writer",
            "writerId",
            false
          ],
          [
            "by-writer-source",
            [
              "writerId",
              "sourceProjectId"
            ],
            false
          ],
          [
            "by-source-project",
            "sourceProjectId",
            false
          ]
        ]
      },
      {
        "name": "narrative-assertions",
        "keyPath": [
          "projectId",
          "id"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ],
          [
            "by-entity",
            [
              "projectId",
              "entityId"
            ],
            false
          ]
        ]
      },
      {
        "name": "document-diagnostics",
        "keyPath": [
          "projectId",
          "documentId"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ]
        ]
      },
      {
        "name": "project-dictionaries",
        "keyPath": [
          "projectId",
          "id"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ],
          [
            "by-project-language-name",
            [
              "projectId",
              "languageIdentifier",
              "normalizedName"
            ],
            true
          ]
        ]
      },
      {
        "name": "dictionary-entries",
        "keyPath": [
          "projectId",
          "id"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ],
          [
            "by-dictionary",
            [
              "projectId",
              "dictionaryId"
            ],
            false
          ],
          [
            "by-dictionary-normalized",
            [
              "projectId",
              "dictionaryId",
              "normalizedForm"
            ],
            true
          ]
        ]
      },
      {
        "name": "language-profiles",
        "keyPath": [
          "projectId",
          "id"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ],
          [
            "by-project-language",
            [
              "projectId",
              "languageIdentifier"
            ],
            false
          ],
          [
            "by-project-active",
            [
              "projectId",
              "isActive"
            ],
            false
          ]
        ]
      },
      {
        "name": "language-resource-refs",
        "keyPath": [
          "projectId",
          "id"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ],
          [
            "by-profile",
            [
              "projectId",
              "profileId"
            ],
            false
          ],
          [
            "by-resource-database",
            [
              "projectId",
              "resourceDatabaseId"
            ],
            false
          ]
        ]
      },
      {
        "name": "style-profiles",
        "keyPath": [
          "projectId",
          "id"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ],
          [
            "by-project-name",
            [
              "projectId",
              "profileName"
            ],
            false
          ]
        ]
      },
      {
        "name": "timeline-tracks",
        "keyPath": [
          "projectId",
          "id"
        ],
        "indexes": [
          [
            "by-project",
            "projectId",
            false
          ],
          [
            "by-project-name",
            [
              "projectId",
              "trackName"
            ],
            false
          ]
        ]
      }
    ]
  },
  "entries": [
    {
      "table": "projects",
      "logicalScope": "global",
      "storageScopes": [
        "system"
      ],
      "keyPrefixes": [
        "host/project-identities/"
      ],
      "representation": "archive",
      "contract": "ProjectIdentity proporcionada por el anfitrión; identidad recibida, no generada por el motor.",
      "implementationStatus": "host-owned",
      "objectStores": []
    },
    {
      "table": "project_settings",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/settings/"
      ],
      "representation": "record",
      "contract": "ProjectSetting en project-settings; valor JSON validado, origen WRITER/HOST y actualización optimista.",
      "implementationStatus": "implemented",
      "objectStores": [
        "project-settings"
      ],
      "keyPath": [
        [
          "projectId",
          "key"
        ]
      ]
    },
    {
      "table": "manuscript_documents",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/documents/",
        "project/change-journal/"
      ],
      "representation": "split-record",
      "contract": "StoredDocument en documents + StoredChange ordenados en changes; checkpoint atómico.",
      "implementationStatus": "implemented",
      "objectStores": [
        "documents",
        "changes"
      ],
      "keyPath": [
        [
          "projectId",
          "documentId"
        ],
        [
          "projectId",
          "documentId",
          "sequence"
        ]
      ]
    },
    {
      "table": "manuscript_fragments",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/documents/text/"
      ],
      "representation": "embedded",
      "contract": "DocumentSnapshot.text; TextBuffer mantiene piezas durante la edición, pero no persiste filas de fragmento independientes.",
      "implementationStatus": "partial",
      "objectStores": [
        "documents"
      ]
    },
    {
      "table": "records",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/narrative-entities/"
      ],
      "representation": "record",
      "contract": "NarrativeEntity en narrative-entities; cobertura actual character/place/object, no todos los tipos dinámicos del esquema.",
      "implementationStatus": "partial",
      "objectStores": [
        "narrative-entities"
      ],
      "keyPath": [
        [
          "projectId",
          "id"
        ]
      ]
    },
    {
      "table": "record_names",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/narrative-entities/names/"
      ],
      "representation": "embedded",
      "contract": "NarrativeEntity.canonicalName + NarrativeEntity.aliases.",
      "implementationStatus": "implemented",
      "objectStores": [
        "narrative-entities"
      ]
    },
    {
      "table": "record_attributes",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/narrative-assertions/"
      ],
      "representation": "record",
      "contract": "NarrativeAssertion en narrative-assertions; atributos actuales limitados a edad, ubicación y cargo/rol.",
      "implementationStatus": "partial",
      "objectStores": [
        "narrative-assertions"
      ],
      "keyPath": [
        [
          "projectId",
          "id"
        ]
      ]
    },
    {
      "table": "relations",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/narrative-relations/"
      ],
      "representation": "record",
      "contract": "NarrativeRelation en narrative-relations.",
      "implementationStatus": "implemented",
      "objectStores": [
        "narrative-relations"
      ],
      "keyPath": [
        [
          "projectId",
          "id"
        ]
      ]
    },
    {
      "table": "relation_attributes",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/narrative-relations/attributes/"
      ],
      "representation": "embedded",
      "contract": "Tipo y evidencia de NarrativeRelation; no existe aún un conjunto genérico de atributos relacionales.",
      "implementationStatus": "partial",
      "objectStores": [
        "narrative-relations"
      ]
    },
    {
      "table": "evidences",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/narrative-entities/evidence/",
        "project/narrative-relations/evidence/",
        "project/narrative-events/evidence/",
        "project/narrative-ideas/evidence/",
        "project/narrative-assertions/evidence/"
      ],
      "representation": "embedded",
      "contract": "TextEvidence integrado en entidades, relaciones, acontecimientos, ideas y afirmaciones; offsets UTF-16.",
      "implementationStatus": "implemented",
      "objectStores": [
        "narrative-entities",
        "narrative-relations",
        "narrative-events",
        "narrative-ideas",
        "narrative-assertions"
      ]
    },
    {
      "table": "timeline_tracks",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/timeline-tracks/"
      ],
      "representation": "record",
      "contract": "TimelineTrack; pistas temporales explícitas y reglas JSON configurables por proyecto, sin inferencia automática.",
      "implementationStatus": "implemented",
      "objectStores": [
        "timeline-tracks"
      ],
      "keyPath": [
        [
          "projectId",
          "id"
        ]
      ]
    },
    {
      "table": "timeline_occurrences",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/narrative-events/timeline/"
      ],
      "representation": "embedded",
      "contract": "NarrativeEvent.timeReference y timelineTrackId dentro de narrative-events; la pista se comprueba contra timeline-tracks en la misma transacción.",
      "implementationStatus": "implemented",
      "objectStores": [
        "narrative-events",
        "timeline-tracks"
      ],
      "keyPath": [
        [
          "projectId",
          "id"
        ]
      ]
    },
    {
      "table": "language_profiles",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/language-profiles/"
      ],
      "representation": "record",
      "contract": "LanguageProfile; perfil REAL o ficticio, preferencias editoriales y cobertura declarada.",
      "implementationStatus": "implemented",
      "objectStores": [
        "language-profiles"
      ],
      "keyPath": [
        [
          "projectId",
          "id"
        ]
      ]
    },
    {
      "table": "language_resource_refs",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/language-resource-refs/"
      ],
      "representation": "record",
      "contract": "LanguageResourceRef; referencia local a un recurso, vinculada opcionalmente a un perfil del mismo proyecto.",
      "implementationStatus": "implemented",
      "objectStores": [
        "language-resource-refs"
      ],
      "keyPath": [
        [
          "projectId",
          "id"
        ]
      ]
    },
    {
      "table": "style_profiles",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/style-profiles/"
      ],
      "representation": "record",
      "contract": "StyleProfile; perfil del libro con rasgos y preferencias editoriales JSON, procedencia y actualización optimista.",
      "implementationStatus": "implemented",
      "objectStores": [
        "style-profiles"
      ],
      "keyPath": [
        [
          "projectId",
          "id"
        ]
      ]
    },
    {
      "table": "active_suggestions",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/document-diagnostics/"
      ],
      "representation": "record",
      "contract": "StoredDiagnostics por documento y revisión en document-diagnostics; no cubre todavía todos los módulos de sugerencias.",
      "implementationStatus": "partial",
      "objectStores": [
        "document-diagnostics"
      ],
      "keyPath": [
        [
          "projectId",
          "documentId"
        ]
      ]
    },
    {
      "table": "import_authorizations",
      "logicalScope": "global",
      "storageScopes": [
        "system"
      ],
      "keyPrefixes": [
        "system/import-authorizations/"
      ],
      "representation": "archive",
      "contract": "Pendiente: autorización explícita de importación entre proyectos del mismo escritor.",
      "implementationStatus": "not-implemented",
      "objectStores": []
    },
    {
      "table": "schema_migrations",
      "logicalScope": "global",
      "storageScopes": [
        "system"
      ],
      "keyPrefixes": [
        "system/indexeddb-version/"
      ],
      "representation": "embedded",
      "contract": "Migraciones nativas onupgradeneeded versionadas por IndexedDB (DATABASE_VERSION=16); sin tabla de historial separada.",
      "implementationStatus": "partial",
      "objectStores": []
    },
    {
      "table": "project_dictionaries",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/dictionaries/"
      ],
      "representation": "record",
      "contract": "ProjectDictionary en project-dictionaries; índice único por proyecto, idioma y nombre normalizado.",
      "implementationStatus": "implemented",
      "objectStores": [
        "project-dictionaries"
      ],
      "keyPath": [
        [
          "projectId",
          "id"
        ]
      ]
    },
    {
      "table": "dictionary_entries",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/dictionary-entries/"
      ],
      "representation": "record",
      "contract": "DictionaryEntry en dictionary-entries; comparación optimista y unicidad de forma normalizada.",
      "implementationStatus": "implemented",
      "objectStores": [
        "dictionary-entries"
      ],
      "keyPath": [
        [
          "projectId",
          "id"
        ]
      ]
    },
    {
      "table": "dictionary_entry_entities",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/dictionary-entries/related-entities/"
      ],
      "representation": "embedded",
      "contract": "DictionaryEntry.relatedEntityIds; vínculos confirmados y validados en la misma transacción que la entrada.",
      "implementationStatus": "implemented",
      "objectStores": [
        "dictionary-entries",
        "narrative-entities"
      ]
    },
    {
      "table": "record_lifecycles",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/record-lifecycles/"
      ],
      "representation": "archive",
      "contract": "Pendiente: historial independiente de cambios de etiqueta y estado de cada ficha.",
      "implementationStatus": "not-implemented",
      "objectStores": []
    },
    {
      "table": "relation_lifecycles",
      "logicalScope": "project",
      "storageScopes": [
        "project"
      ],
      "keyPrefixes": [
        "project/relation-lifecycles/"
      ],
      "representation": "archive",
      "contract": "Pendiente: historial independiente de cambios de etiqueta y estado de cada relación.",
      "implementationStatus": "not-implemented",
      "objectStores": []
    },
    {
      "table": "writer_library_ideas",
      "logicalScope": "writer",
      "storageScopes": [
        "writer"
      ],
      "keyPrefixes": [
        "writer/personal-idea-library/"
      ],
      "representation": "record",
      "contract": "PersonalIdeaLibraryEntry en personal-idea-library; keyPath writerId/sourceProjectId/idea.id.",
      "implementationStatus": "implemented",
      "objectStores": [
        "personal-idea-library"
      ],
      "keyPath": [
        [
          "writerId",
          "sourceProjectId",
          "idea.id"
        ]
      ]
    },
    {
      "table": "writer_library_finalization_receipts",
      "logicalScope": "writer",
      "storageScopes": [
        "writer"
      ],
      "keyPrefixes": [
        "writer/finalization-receipts/"
      ],
      "representation": "record",
      "contract": "StoredProjectFinalizationReceipt; recibo idempotente con checksum, archivadoIdeaIds y escritura atómica junto a la transferencia.",
      "implementationStatus": "implemented",
      "objectStores": [
        "writer-library-finalization-receipts"
      ],
      "keyPath": [
        [
          "writerId",
          "sourceProjectId",
          "receiptId"
        ]
      ]
    }
  ],
  "projectSettings": {
    "table": "project_settings",
    "logicalScope": "project",
    "storageScopes": [
      "project"
    ],
    "keyPrefixes": [
      "project/settings/"
    ],
    "representation": "record",
    "contract": "ProjectSetting en project-settings; valor JSON validado, origen WRITER/HOST y actualización optimista.",
    "implementationStatus": "implemented",
    "objectStores": [
      "project-settings"
    ],
    "keyPath": [
      [
        "projectId",
        "key"
      ]
    ]
  }
}
