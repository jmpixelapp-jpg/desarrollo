{
  "name": "motor-literario-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Núcleo propio de Motor Literario en TypeScript",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "npm run build && npm run validate:schema && node --test tests/*.test.mjs test/*.test.mjs",
    "bench": "npm run build && node bench/live-edit-benchmark.mjs",
    "validate:schema": "node scripts/validate-mldb-schema.mjs && node scripts/audit-storage-implementation.mjs",
    "bridge": "npm run build && node bridge/stdio-server.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
